{
  "name": "codex-authx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manage multiple Codex auth profiles locally.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikkofu/codex-authx.git"
  },
  "homepage": "https://github.com/nikkofu/codex-authx",
  "bin": {
    "codex-authx": "./bin/codex-authx.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "build:js": "tsc -p tsconfig.json",
    "build:bin": "node ./scripts/build-release.mjs",
    "build:release": "npm run build:js && npm run build:bin",
    "codex-authx": "node ./bin/codex-authx.js"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
